{
  "name": "bdd-vitest",
  "version": "2.1.0",
  "type": "module",
  "description": "Opinionated BDD for Vitest. Your tests are your documentation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adelost/bdd-vitest.git"
  },
  "keywords": [
    "vitest",
    "bdd",
    "given-when-then",
    "testing",
    "scenario",
    "behavior-driven"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./mock-ai": {
      "import": {
        "types": "./dist/mock-ai.d.ts",
        "default": "./dist/mock-ai.js"
      },
      "require": {
        "types": "./dist/mock-ai.d.cts",
        "default": "./dist/mock-ai.cjs"
      }
    },
    "./service": {
      "import": {
        "types": "./dist/service.d.ts",
        "default": "./dist/service.js"
      },
      "require": {
        "types": "./dist/service.d.cts",
        "default": "./dist/service.cjs"
      }
    },
    "./process": {
      "import": {
        "types": "./dist/process.d.ts",
        "default": "./dist/process.js"
      },
      "require": {
        "types": "./dist/process.d.cts",
        "default": "./dist/process.cjs"
      }
    },
    "./levels": {
      "import": {
        "types": "./dist/levels.d.ts",
        "default": "./dist/levels.js"
      },
      "require": {
        "types": "./dist/levels.d.cts",
        "default": "./dist/levels.cjs"
      }
    },
    "./mock-server": {
      "import": {
        "types": "./dist/mock-server.d.ts",
        "default": "./dist/mock-server.js"
      },
      "require": {
        "types": "./dist/mock-server.d.cts",
        "default": "./dist/mock-server.cjs"
      }
    },
    "./mock-fetch": {
      "import": {
        "types": "./dist/mock-fetch.d.ts",
        "default": "./dist/mock-fetch.js"
      },
      "require": {
        "types": "./dist/mock-fetch.d.cts",
        "default": "./dist/mock-fetch.cjs"
      }
    },
    "./preset": {
      "import": {
        "types": "./dist/preset.d.ts",
        "default": "./dist/preset.js"
      },
      "require": {
        "types": "./dist/preset.d.cts",
        "default": "./dist/preset.cjs"
      }
    },
    "./contract": {
      "import": {
        "types": "./dist/contract.d.ts",
        "default": "./dist/contract.js"
      },
      "require": {
        "types": "./dist/contract.d.cts",
        "default": "./dist/contract.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CONTRACT.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "vitest": ">=2.0.0 <5.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build && pnpm test && npm pack --dry-run"
  },
  "packageManager": "pnpm@10.28.1"
}
